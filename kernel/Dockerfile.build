# Reproducible build environment for the Unikraft elfloader kernel.
# Pinned to Ubuntu 24.04 (gcc-13) so every machine produces the same binary.
FROM ubuntu:24.04

RUN apt-get update -q && \
    apt-get install -y --no-install-recommends \
        build-essential bison flex libncurses-dev python3 make && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /kernel
