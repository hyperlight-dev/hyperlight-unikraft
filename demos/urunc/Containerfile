#syntax=harbor.nbfc.io/nubificus/bunny:latest
#
# Package a hyperlight-unikraft guest (kernel + rootfs CPIO) as an OCI image
# that urunc's hyperlight-unikraft monitor runs. The bunny frontend turns these
# LABELs into the com.urunc.unikernel.* OCI annotations and the in-image
# urunc.json; the CMD is what urunc hands hluk as the guest command.
#
# Stage the kernel and rootfs first (`just stage`), then:
#   docker build -f Containerfile -t hluk/hello-urunc:demo .
FROM scratch

COPY elfloader_hyperlight-x86_64 /unikernel/kernel
COPY initrd.cpio                 /unikernel/initrd.cpio

LABEL "com.urunc.unikernel.binary"="/unikernel/kernel"
LABEL "com.urunc.unikernel.initrd"="/unikernel/initrd.cpio"
LABEL "com.urunc.unikernel.unikernelType"="unikraft"
LABEL "com.urunc.unikernel.hypervisor"="hyperlight-unikraft"

# The guest command: a file inside the initrd, plus any arguments. An image
# declares what it runs, like any container image; engines such as Docker
# refuse to start one that declares nothing.
CMD ["/app/hello.py"]
