# python-pptx rootfs — extends python-shell with python-pptx (pulls in lxml + Pillow).
#
# No prebuilt rootfs ships python-pptx (or its lxml/Pillow C extensions), so a
# custom rootfs is needed regardless; python-shell is the smallest base that has
# pip. python-pptx installs as manylinux wheels, so no compiler is required.
#
# Build:  just build-rootfs pptx demos/pptx-gen/Dockerfile.rootfs
# -arm64 when `just build-rootfs` builds for another platform
# (HLUK_ROOTFS_PLATFORM), so the base is that platform's image too.
ARG ROOTFS_SUFFIX=
FROM hluk-python-shell-rootfs${ROOTFS_SUFFIX}:latest AS base

FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258 AS installer
COPY --from=base / /rootfs/
RUN pip install --no-cache-dir --target /rootfs/usr/local/lib/python3.12/site-packages \
        python-pptx

FROM scratch
COPY --from=installer /rootfs/ /
