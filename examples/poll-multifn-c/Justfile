# poll-multifn-c on Hyperlight (cooperative poll model, named guest calls)
#
# just rootfs   - Build rootfs via Docker (cross-platform)
# just build    - Build the poll-enabled kernel via kraft
# just clean    - Remove build artifacts
#
# The kernel is built with CONFIG_HYPERLIGHT_POLL=y and CONFIG_HYPERLIGHT_HCALL=y
# (see kraft.yaml). The host-side live test `host/tests/poll_multifn.rs` drives
# this guest under KVM with `Sandbox::call_named_async`. main() registers an
# FC-aware dispatch callback and halts; every later named call is routed by the
# kernel to a scheduler thread, so the handler can block mid-call and the vCPU
# still returns to the host between steps.

set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]
export DOCKER_BUILDKIT := "0"

kernel := ".unikraft/build/poll-multifn-hyperlight_hyperlight-x86_64"
initrd := "poll-multifn-initrd.cpio"
image  := "poll-multifn-c-hyperlight"

# Build rootfs via Docker (cross-platform)
rootfs:
    docker build --platform linux/amd64 --target cpio -t {{image}}-cpio .
    - docker rm -f {{image}}-tmp
    docker create --name {{image}}-tmp {{image}}-cpio /bin/true
    docker cp {{image}}-tmp:/output.cpio ./{{initrd}}
    docker rm -f {{image}}-tmp

# Build kernel via kraft (Linux)
[unix]
build:
    -kraft-hyperlight build --plat hyperlight --arch x86_64

# Clean + rebuild everything
rebuild: clean build rootfs

# Clean build artifacts
[unix]
clean:
    rm -rf .unikraft {{initrd}}

[windows]
clean:
    if (Test-Path .unikraft) { Remove-Item -Recurse -Force .unikraft }
    if (Test-Path {{initrd}}) { Remove-Item -Force {{initrd}} }
