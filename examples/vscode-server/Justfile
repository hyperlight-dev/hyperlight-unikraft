# vscode-server on Hyperlight
#
# just build     - Build kernel + rootfs
# just run       - Start VS Code Server (open http://localhost:8000 in browser)
# just test      - Build, run, and verify HTTP 200
# just clean     - Remove build artifacts

set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]
export DOCKER_BUILDKIT := "0"

kernel      := ".unikraft/build/vscode-server-hyperlight_hyperlight-x86_64"
initrd      := "initrd.cpio"
memory      := "3840Mi"
image       := "vscode-server-hyperlight"
port        := "8000"

# Start VS Code Server (browse to http://localhost:8000)
run:
    mkdir -p data
    hyperlight-unikraft {{kernel}} --initrd {{initrd}} --memory {{memory}} \
        --net --port {{port}} \
        --mount ./data:/data \
        -- --max-old-space-size=1024 \
           /opt/vscode-server/out/server-main.js \
           --port {{port}} \
           --host 0.0.0.0 \
           --without-connection-token \
           --server-data-dir /data \
           --extensions-dir /data/extensions \
           --accept-server-license-terms \
           --force-disable-user-env

# Build rootfs via Docker
rootfs:
    docker build --platform linux/amd64 -t {{image}} .
    docker run --rm {{image}} cat /output.cpio > {{initrd}}

# Build kernel via kraft (Linux)
[unix]
build:
    kraft-hyperlight --no-prompt build --plat hyperlight --arch x86_64

# Pull pre-built kernel from GHCR (Windows — no kernel published yet)
[windows]
build:
    Write-Host "No pre-built kernel for vscode-server yet. Build on Linux first."

# Build, run, and verify HTTP 200
[unix]
test: build rootfs
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p data
    hyperlight-unikraft {{kernel}} --initrd {{initrd}} --memory {{memory}} \
        --net --port {{port}} \
        --mount ./data:/data \
        -- --max-old-space-size=1024 \
           /opt/vscode-server/out/server-main.js \
           --port {{port}} \
           --host 0.0.0.0 \
           --without-connection-token \
           --server-data-dir /data \
           --extensions-dir /data/extensions \
           --accept-server-license-terms \
           --force-disable-user-env &
    PID=$!
    trap "kill $PID 2>/dev/null" EXIT
    until curl -s -o /dev/null -w '' http://localhost:{{port}}/version 2>/dev/null; do sleep 2; done
    STATUS=$(curl -s -o /dev/null -w '%{http_code}' -m 15 http://localhost:{{port}}/)
    echo "GET / -> HTTP $STATUS"
    [ "$STATUS" = "200" ] && echo "PASS" || { echo "FAIL"; exit 1; }

# Clean + rebuild everything
rebuild: clean build rootfs

# Clean build artifacts
[unix]
clean:
    rm -rf .unikraft {{initrd}} data

[windows]
clean:
    if (Test-Path .unikraft) { Remove-Item -Recurse -Force .unikraft }
    if (Test-Path {{initrd}}) { Remove-Item -Force {{initrd}} }
    if (Test-Path data) { Remove-Item -Recurse -Force data }
