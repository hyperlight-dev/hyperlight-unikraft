/* Taken from solo5 */

#include <uk/arch/x86_64.h>
#include <x86/traps.h>
#include <uk/asm/cfi.h>
#include <uk/intctlr.h>
#include <uk/lcpu.h>

.altmacro

#define ENTRY(X)     .global X ; .type X, @function ; X:

.macro PUSH_CALLER_SAVE
	pushq_reg_cfi rdi
	pushq_reg_cfi rsi
	pushq_reg_cfi rdx
	pushq_reg_cfi rcx
	pushq_reg_cfi rax
	pushq_reg_cfi r8
	pushq_reg_cfi r9
	pushq_reg_cfi r10
	pushq_reg_cfi r11
	pushq_reg_cfi rbx
	pushq_reg_cfi rbp
	pushq_reg_cfi r12
	pushq_reg_cfi r13
	pushq_reg_cfi r14
	pushq_reg_cfi r15
.endm

.macro POP_CALLER_SAVE
	popq_reg_cfi r15
	popq_reg_cfi r14
	popq_reg_cfi r13
	popq_reg_cfi r12
	popq_reg_cfi rbp
	popq_reg_cfi rbx
	popq_reg_cfi r11
	popq_reg_cfi r10
	popq_reg_cfi r9
	popq_reg_cfi r8
	popq_reg_cfi rax
	popq_reg_cfi rcx
	popq_reg_cfi rdx
	popq_reg_cfi rsi
	popq_reg_cfi rdi
.endm

/* Save XMM0-XMM15 below the struct on the stack. The CoW page-fault
 * handler calls memcpy which uses SSE and clobbers XMM registers.
 * Interrupted code (e.g. libpython's GC_Track) may hold live values
 * in XMM across a memory access that triggers a CoW fault. */
.macro XMM_SAVE
	subq  $256, %rsp
	.cfi_adjust_cfa_offset 256
	movups %xmm0,  0x00(%rsp)
	movups %xmm1,  0x10(%rsp)
	movups %xmm2,  0x20(%rsp)
	movups %xmm3,  0x30(%rsp)
	movups %xmm4,  0x40(%rsp)
	movups %xmm5,  0x50(%rsp)
	movups %xmm6,  0x60(%rsp)
	movups %xmm7,  0x70(%rsp)
	movups %xmm8,  0x80(%rsp)
	movups %xmm9,  0x90(%rsp)
	movups %xmm10, 0xa0(%rsp)
	movups %xmm11, 0xb0(%rsp)
	movups %xmm12, 0xc0(%rsp)
	movups %xmm13, 0xd0(%rsp)
	movups %xmm14, 0xe0(%rsp)
	movups %xmm15, 0xf0(%rsp)
.endm

.macro XMM_RESTORE
	movups 0x00(%rsp), %xmm0
	movups 0x10(%rsp), %xmm1
	movups 0x20(%rsp), %xmm2
	movups 0x30(%rsp), %xmm3
	movups 0x40(%rsp), %xmm4
	movups 0x50(%rsp), %xmm5
	movups 0x60(%rsp), %xmm6
	movups 0x70(%rsp), %xmm7
	movups 0x80(%rsp), %xmm8
	movups 0x90(%rsp), %xmm9
	movups 0xa0(%rsp), %xmm10
	movups 0xb0(%rsp), %xmm11
	movups 0xc0(%rsp), %xmm12
	movups 0xd0(%rsp), %xmm13
	movups 0xe0(%rsp), %xmm14
	movups 0xf0(%rsp), %xmm15
	addq  $256, %rsp
	.cfi_adjust_cfa_offset -256
.endm

.macro TRAP_ENTRY trapname, trapnr, has_ec
ENTRY(ASM_TRAP_SYM(\trapname))
	.cfi_startproc simple
	.cfi_signal_frame
	.cfi_def_cfa rsp, 0
.if \has_ec
	/* Error code is pushed on the stack after the return address */
	.cfi_def_cfa_offset 16
.else
	/* There is only the return address on the stack */
	.cfi_def_cfa_offset 8
.endif
	.cfi_offset rip, -8
	/* Description of the stack with active IST */
	.cfi_offset cs, 0

#ifdef __clang__
	.cfi_offset flags, 8
#elif __GNUC__
	.cfi_offset rflags, 8
#else
#error "Unsupported Compiler"
#endif

	.cfi_offset rsp, 16
	.cfi_offset ss, 24
	cld

.if !\has_ec
	pushq_cfi $0                        /* no error code, pass 0 */
.endif
	PUSH_CALLER_SAVE
	/* we have some padding */
	subq $UK_LCPU_X86_64_REGS_OFFSETOF_R15, %rsp
	.cfi_adjust_cfa_offset UK_LCPU_X86_64_REGS_OFFSETOF_R15

	/* Save XMM registers below the struct frame */
	XMM_SAVE

	movq $\trapnr, %rdi
	leaq 256(%rsp), %rsi
	movq (UK_LCPU_X86_64_REGS_OFFSETOF_ORIG_RAX + 256)(%rsp), %rdx
	call uk_plat_native_except_err_handler

	XMM_RESTORE

	/* we have some padding */
	addq $UK_LCPU_X86_64_REGS_OFFSETOF_R15, %rsp
	.cfi_adjust_cfa_offset -UK_LCPU_X86_64_REGS_OFFSETOF_R15
	POP_CALLER_SAVE
	addq $8, %rsp                       /* discard error code */
	.cfi_adjust_cfa_offset -8

	iretq
	.cfi_endproc
.endm

.macro IRQ_ENTRY irqno
ENTRY(cpu_irq_\irqno)
	.cfi_startproc simple
	.cfi_signal_frame
	.cfi_def_cfa rsp, 8
	.cfi_offset rip, -8

	/* Description of the stack with active IST */
	.cfi_offset cs, 0

#ifdef __clang__
	.cfi_offset flags, 8
#elif __GNUC__
	.cfi_offset rflags, 8
#else
#error "Unsupported Compiler"
#endif

	.cfi_offset rsp, 16
	.cfi_offset ss, 24
	cld

	pushq_cfi $0                        /* no error code */
	PUSH_CALLER_SAVE
	/* we have some padding */
	subq $UK_LCPU_X86_64_REGS_OFFSETOF_R15, %rsp
	.cfi_adjust_cfa_offset UK_LCPU_X86_64_REGS_OFFSETOF_R15

	/* Save XMM registers below the struct frame */
	XMM_SAVE

	leaq 256(%rsp), %rdi
	movq $\irqno, %rsi
	call uk_plat_native_except_irq_handler

	XMM_RESTORE

	/* we have some padding */
	addq $UK_LCPU_X86_64_REGS_OFFSETOF_R15, %rsp
	.cfi_adjust_cfa_offset -UK_LCPU_X86_64_REGS_OFFSETOF_R15
	POP_CALLER_SAVE
	addq $8, %rsp
	.cfi_adjust_cfa_offset -8

	iretq
	.cfi_endproc
.endm

TRAP_ENTRY divide_error,     UK_ARCH_X86_64_TRAPNUM_DIVIDE_ERROR, 0
TRAP_ENTRY debug,            UK_ARCH_X86_64_TRAPNUM_DEBUG, 0
TRAP_ENTRY nmi,              UK_ARCH_X86_64_TRAPNUM_NMI, 0
TRAP_ENTRY int3,             UK_ARCH_X86_64_TRAPNUM_INT3, 0
TRAP_ENTRY overflow,         UK_ARCH_X86_64_TRAPNUM_OVERFLOW, 0
TRAP_ENTRY bounds,           UK_ARCH_X86_64_TRAPNUM_BOUNDS, 0
TRAP_ENTRY invalid_op,       UK_ARCH_X86_64_TRAPNUM_INVALID_OP, 0
TRAP_ENTRY no_device,        UK_ARCH_X86_64_TRAPNUM_NO_DEVICE, 0
TRAP_ENTRY double_fault,     UK_ARCH_X86_64_TRAPNUM_DOUBLE_FAULT, 1
TRAP_ENTRY invalid_tss,      UK_ARCH_X86_64_TRAPNUM_INVALID_TSS, 1
TRAP_ENTRY no_segment,       UK_ARCH_X86_64_TRAPNUM_NO_SEGMENT, 1
TRAP_ENTRY stack_error,      UK_ARCH_X86_64_TRAPNUM_STACK_ERROR, 1
TRAP_ENTRY gp_fault,         UK_ARCH_X86_64_TRAPNUM_GP_FAULT, 1
TRAP_ENTRY page_fault,       UK_ARCH_X86_64_TRAPNUM_PAGE_FAULT, 1
TRAP_ENTRY coproc_error,     UK_ARCH_X86_64_TRAPNUM_COPROC_ERROR, 0
TRAP_ENTRY alignment_check,  UK_ARCH_X86_64_TRAPNUM_ALIGNMENT_CHECK, 1
TRAP_ENTRY machine_check,    UK_ARCH_X86_64_TRAPNUM_MACHINE_CHECK, 0
TRAP_ENTRY simd_error,       UK_ARCH_X86_64_TRAPNUM_SIMD_ERROR, 0
TRAP_ENTRY virt_error,       UK_ARCH_X86_64_TRAPNUM_VIRT_ERROR, 0

.set irqno, 0
.rept UK_ARCH_X86_64_IDT_NUM_ENTRIES-32
IRQ_ENTRY %irqno
.set irqno, irqno + 1
.endr
.noaltmacro

/*
 * Preemption trampoline — entered via modified iretq RIP when the
 * timer interrupt wants to yield.  Runs on the interrupted thread's
 * stack with all registers restored to pre-interrupt values.
 */
.global pv_timer_trampoline
.type pv_timer_trampoline, @function
pv_timer_trampoline:
	leaq  -128(%rsp), %rsp		/* skip red zone without modifying flags */
	pushfq				/* save original RFLAGS first */

	pushq %rax
	pushq %rcx
	pushq %rdx
	pushq %rsi
	pushq %rdi
	pushq %r8
	pushq %r9
	pushq %r10
	pushq %r11

	/* Copy the global saved_rip onto THIS thread's stack so it
	 * survives across uk_sched_yield() even if another thread
	 * gets preempted and overwrites the global.  r11 is already
	 * saved above so we can use it as scratch. */
	movq  pv_timer_saved_rip(%rip), %r11
	pushq %r11

	subq  $256, %rsp
	movups %xmm0,  0x00(%rsp)
	movups %xmm1,  0x10(%rsp)
	movups %xmm2,  0x20(%rsp)
	movups %xmm3,  0x30(%rsp)
	movups %xmm4,  0x40(%rsp)
	movups %xmm5,  0x50(%rsp)
	movups %xmm6,  0x60(%rsp)
	movups %xmm7,  0x70(%rsp)
	movups %xmm8,  0x80(%rsp)
	movups %xmm9,  0x90(%rsp)
	movups %xmm10, 0xa0(%rsp)
	movups %xmm11, 0xb0(%rsp)
	movups %xmm12, 0xc0(%rsp)
	movups %xmm13, 0xd0(%rsp)
	movups %xmm14, 0xe0(%rsp)
	movups %xmm15, 0xf0(%rsp)

	call  pv_timer_yield

	movups 0x00(%rsp), %xmm0
	movups 0x10(%rsp), %xmm1
	movups 0x20(%rsp), %xmm2
	movups 0x30(%rsp), %xmm3
	movups 0x40(%rsp), %xmm4
	movups 0x50(%rsp), %xmm5
	movups 0x60(%rsp), %xmm6
	movups 0x70(%rsp), %xmm7
	movups 0x80(%rsp), %xmm8
	movups 0x90(%rsp), %xmm9
	movups 0xa0(%rsp), %xmm10
	movups 0xb0(%rsp), %xmm11
	movups 0xc0(%rsp), %xmm12
	movups 0xd0(%rsp), %xmm13
	movups 0xe0(%rsp), %xmm14
	movups 0xf0(%rsp), %xmm15
	addq  $256, %rsp

	/* Pop the per-thread saved RIP into scratch r11, then park
	 * it in the return_rip global for the final jmpq.  r11 is
	 * immediately restored from the stack right after this. */
	popq  %r11
	movq  %r11, pv_timer_return_rip(%rip)

	popq  %r11
	popq  %r10
	popq  %r9
	popq  %r8
	popq  %rdi
	popq  %rsi
	popq  %rdx
	popq  %rcx
	popq  %rax
	popfq				/* restore original RFLAGS */

	leaq  128(%rsp), %rsp		/* restore over red zone without modifying flags */
	jmpq  *pv_timer_return_rip(%rip)
